# ============================================
# Supabase — used by web app + sitemap Edge Function
# ============================================
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ============================================
# Web App (apps/web) — prefix with VITE_
# Note: VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY also serve
# as the backend credentials for the /api/sitemap Edge Function.
# ============================================
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-key
VITE_APP_URL=https://3qaratjaramana.com

# ============================================
# Admin Dashboard (apps/admin)
# Uses the same VITE_SUPABASE_* keys as the web app.
# Set these in the separate Vercel "admin" project as well.
# ============================================

# ============================================
# Mobile App (apps/mobile) — prefix with EXPO_PUBLIC_
# ============================================
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-key
EXPO_PUBLIC_APP_URL=https://3qaratjaramana.com
